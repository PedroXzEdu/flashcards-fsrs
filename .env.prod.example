# =============================================================================
# FlashFSRS — Variáveis de Ambiente para Produção
# =============================================================================
# Copie este arquivo para .env e ajuste os valores antes do deploy:
#   cp .env.prod.example backend/.env
# =============================================================================

# --- Banco de Dados (PostgreSQL) -------------------------------------------
# Host do banco. No Docker Compose, use o nome do serviço ("db").
DB_HOST=db

# Porta do banco (padrão PostgreSQL: 5432)
DB_PORT=5432

# Usuário do banco (deve ser o mesmo definido no serviço db do compose)
DB_USER=admin

# Senha do banco (OBRIGATÓRIA — troque para produção!)
DB_PASSWORD=change-me-to-a-secure-password

# Nome do banco de dados
DB_NAME=flashcards_fsrs

# --- Autenticação -----------------------------------------------------------
# Chave secreta para assinar tokens JWT (OBRIGATÓRIA — troque para produção!)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# --- Servidor ---------------------------------------------------------------
# Porta do backend (padrão: 3000)
PORT=3000

# Origens permitidas para CORS (separadas por vírgula)
# Exemplo: CORS_ORIGIN=https://meudominio.com,https://www.meudominio.com
CORS_ORIGIN=http://localhost
