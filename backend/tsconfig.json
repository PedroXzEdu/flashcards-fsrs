{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "moduleResolution": "node",
    "types": ["node"]
  },

  "include": ["src"],

  "exclude": ["tests", "**/*.test.ts", "**/__tests__/**"]
}
