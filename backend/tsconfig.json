{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "moduleResolution": "bundler"
  },

  "include": ["src"],

  "typeRoots": ["./node_modules/@types", "./src/types"]
}
