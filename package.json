{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "opencode-ai": "^1.15.4",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "scripts": {
    "format": "prettier --write '**/*.{ts,tsx,js,json,css,md}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,json,css,md}'",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ]
  }
}
